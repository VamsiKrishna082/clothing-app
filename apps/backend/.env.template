# Local development — copy to .env
DATABASE_URL=postgres://localhost:5432/tharam
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Storefront cache revalidation — same secret as the storefront's REVALIDATE_SECRET
STOREFRONT_URL=http://localhost:8000
REVALIDATE_SECRET=change-me

# Cloud only (set by Terraform / Secret Manager). Leave unset locally.
# REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
# DB_POOL_MAX=6
# MEDUSA_WORKER_MODE=server
# ADMIN_BACKEND_URL=https://admin.tharam.in
# S3_BUCKET=tharam-media
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FILE_URL=https://media.tharam.in
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
